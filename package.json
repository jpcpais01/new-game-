{
  "name": "clashborn",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/patchnotes.test.ts src/sim/battle.test.ts src/sim/ai/ai.test.ts src/gear/skins.test.ts src/render/fighter/handPlan.test.ts",
    "sim": "vitest run src/sim/balance.test.ts --disable-console-intercept",
    "duel": "vitest run scripts/duel.test.ts --dir . --disable-console-intercept",
    "icons": "node scripts/icons.mjs",
    "ai": "vitest run src/sim/ai.bench.test.ts --disable-console-intercept"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
